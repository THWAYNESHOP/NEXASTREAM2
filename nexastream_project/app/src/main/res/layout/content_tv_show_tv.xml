<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="40dp">

    <ImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="180dp"
        android:layout_height="0dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="30dp"
        android:adjustViewBounds="true"
        android:elevation="8dp"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="40dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="70dp"
        tools:text="TV Show Title" />

    <LinearLayout
        android:id="@+id/ll_tv_show_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/tv_tv_show_title"
        app:layout_constraintStart_toStartOf="@id/tv_tv_show_title"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_title">

        <ImageView
            android:id="@+id/iv_tv_show_rating_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star"
            android:tint="#FFD700"
            tools:ignore="ContentDescription,UseAppTint" />

        <TextView
            android:id="@+id/tv_tv_show_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            tools:text="8.5" />

        <TextView
            android:id="@+id/tv_tv_show_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_quality_tag"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="HD" />

        <TextView
            android:id="@+id/tv_tv_show_released"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            tools:text="2024" />

        <TextView
            android:id="@+id/tv_tv_show_runtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            tools:text="45m" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tv_show_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#80FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/tv_tv_show_title"
        app:layout_constraintStart_toStartOf="@id/tv_tv_show_title"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_meta"
        tools:text="Drama, Mystery" />

    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:maxLines="6"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/tv_tv_show_title"
        app:layout_constraintStart_toStartOf="@id/tv_tv_show_title"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_genres"
        tools:text="Detailed overview of the TV show goes here. This should be readable and provide enough context for the user to decide if they want to watch it." />

    <LinearLayout
        android:id="@+id/ll_tv_show_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/tv_tv_show_title"
        app:layout_constraintStart_toStartOf="@id/tv_tv_show_title"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview">

        <TextView
            android:id="@+id/btn_tv_show_watch_now"
            style="@style/AppTheme.Widget.Tv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:stateListAnimator="@animator/item_season_tv_zoom"
            android:text="@string/tv_show_watch_season_episode" />

        <TextView
            android:id="@+id/btn_tv_show_trailer"
            style="@style/AppTheme.Widget.Tv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:stateListAnimator="@animator/item_season_tv_zoom"
            android:text="@string/tv_show_trailer" />

        <ImageView
            android:id="@+id/btn_tv_show_favorite"
            style="@style/AppTheme.Widget.Tv.Button"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_favorite_disable"
            android:stateListAnimator="@animator/item_season_tv_zoom"
            android:tint="@drawable/color_button_text"
            tools:ignore="ContentDescription,UseAppTint" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_tv_show_progress_episode"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#33FFFFFF"
        android:progressTint="#E50914"
        app:layout_constraintEnd_toEndOf="@id/ll_tv_show_actions"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@id/ll_tv_show_actions"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_actions"
        app:layout_constraintWidth_max="200dp"
        tools:progress="60" />

</androidx.constraintlayout.widget.ConstraintLayout>
