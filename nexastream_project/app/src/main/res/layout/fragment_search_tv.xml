<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.search.SearchTvFragment">

    <!-- Left Panel: Keyboard and Actions -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search_left"
        android:layout_width="400dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.leanback.widget.SearchEditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_edittext"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFF"
            android:focusable="false"
            android:gravity="center_vertical"
            android:hint="@string/search_input_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="14dp"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hgv_suggestions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_search"
            tools:listitem="@layout/item_search_suggestion_tv"
            tools:visibility="visible" />

        <com.nexastream.app.ui.components.SearchKeyboardView
            android:id="@+id/keyboard_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hgv_suggestions" />

        <LinearLayout
            android:id="@+id/ll_keyboard_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/keyboard_view">

            <Button
                android:id="@+id/btn_key_space"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SPACE"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_exoplayer_tv"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btn_key_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DEL"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_exoplayer_tv"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_global_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_keyboard_actions">

            <TextView
                android:id="@+id/tv_global_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/global_search"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_global_search_switch"
                android:layout_width="32dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_switch_off"
                tools:ignore="ContentDescription" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btn_search_voice"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_mic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_global_search"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_search_clear"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_search_clear"
            app:layout_constraintBottom_toBottomOf="@id/btn_search_voice"
            app:layout_constraintStart_toEndOf="@id/btn_search_voice"
            app:layout_constraintTop_toTopOf="@id/btn_search_voice"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_search_filter"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_filter"
            app:layout_constraintBottom_toBottomOf="@id/btn_search_voice"
            app:layout_constraintStart_toEndOf="@id/btn_search_clear"
            app:layout_constraintTop_toTopOf="@id/btn_search_voice"
            app:tint="#FFFFFF" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Right Panel: Results -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cl_search_left"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_movie_tv" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/vgv_search"
        app:layout_constraintStart_toStartOf="@id/vgv_search"
        app:layout_constraintTop_toTopOf="@id/vgv_search" />

</androidx.constraintlayout.widget.ConstraintLayout>
